{"schema_version":1,"tests":[{"id":"example-1","visibility":"visible","category":"example","input":{"tracks":[1,2,3,4,5],"k":2},"expected":[4,5,1,2,3],"explanation":"After one press: `[5, 1, 2, 3, 4]`; after two: `[4, 5, 1, 2, 3]`."},{"id":"example-2","visibility":"visible","category":"example","input":{"tracks":[7,8],"k":5},"expected":[8,7],"explanation":"Five presses on two tracks is the same as one press."},{"id":"hidden-1","visibility":"hidden","category":"empty playlist","input":{"tracks":[],"k":3},"expected":[]},{"id":"hidden-2","visibility":"hidden","category":"zero presses","input":{"tracks":[4,1,9],"k":0},"expected":[4,1,9]},{"id":"hidden-3","visibility":"hidden","category":"single track","input":{"tracks":[42],"k":1000},"expected":[42]},{"id":"hidden-4","visibility":"hidden","category":"k is a multiple of the length","input":{"tracks":[1,2,3,4],"k":8},"expected":[1,2,3,4]},{"id":"hidden-5","visibility":"hidden","category":"huge k","input":{"tracks":[5,6,7,8,9,10,11],"k":1000000000},"expected":[6,7,8,9,10,11,5]},{"id":"hidden-6","visibility":"hidden","category":"duplicates","input":{"tracks":[3,3,1,3],"k":1},"expected":[3,3,3,1]},{"id":"hidden-7","visibility":"hidden","category":"random","input":{"tracks":[-11,-20,47,43,-2,-41,15,-45,-24,-19,10,-22,30,-30,-37,49,23,47,47,25,-46,-16,-21,-40,-21,22,10,-27,48,-2],"k":17},"expected":[-30,-37,49,23,47,47,25,-46,-16,-21,-40,-21,22,10,-27,48,-2,-11,-20,47,43,-2,-41,15,-45,-24,-19,10,-22,30]},{"id":"hidden-8","visibility":"hidden","category":"random","input":{"tracks":[5,9,3,1,0,6,2,6,7,8,5],"k":123},"expected":[8,5,5,9,3,1,0,6,2,6,7]}]}
